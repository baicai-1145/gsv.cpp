From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dec-opt <dec-opt@team>
Date: Thu, 8 Oct 2026 00:00:00 +0800
Subject: [PATCH] ggml-cpu: vectorise the conv_direct_1d epilogue (6x16 -> 16x6
 register transpose, bias/res/leaky folded in)

The conv_direct_1d CPU micro-kernel accumulates 16 oc x 6 t per tile (lane = oc,
one register per t), but the destination layout is [oc][t], so each oc needs its 6
t values contiguous. The old epilogue stored the 12 accumulator vectors into
tmp[6][8] and read back 96 scalars:
  - a 32B store feeding 4B loads stalls in store-to-load forwarding,
  - 96 scalar stores occupy the (1 store/cycle) store port,
  - and the 12 vector stores were re-issued per oc (16x redundant).
On the dec tail shapes (IC=16/32, K=3) that was ~50% of the tile time, which is why
stage4 sat at 49% and stage3 at 65% of the AVX2 FMA peak while stage1 (IC=128, K=11)
reached 73%.

Now the epilogue stays in registers: bias is added while the lanes are still oc, a
6x8 transpose (22 shuffles) per oc half turns each oc's 6 t values into one register,
and the result goes out as a 16B + 8B store (never a full 32B store: lanes 6/7 belong
to the next t block, possibly another thread's). Residual add and the leaky_relu are
folded in; with a residual the activation is deferred to the t-major step so the
order (bias+acc, +res, act) is unchanged. tanh activations (slope < 0) keep the old
scalar path, and that path is the old epilogue verbatim.

BUG FIXED IN THIS REVISION (an earlier revision of this patch was wrong in the real
pipeline): the tanh fallback had the tanhf(v) call replaced by the leaky formula, so
dec.conv_post - which passes leaky_slope = -1.0f to mean tanh - computed
leaky(z) = z if z>0 else 0.1*z instead of tanh(z). The decoded wav then carried a large
positive DC component and was uncorrelated with the reference (wav cos 0.140, max_abs
0.93, 10 ms energy envelope preserved, FFT peak at bin 0) while every bench shape still
passed, because no bench row exercised slope < 0. The fallback is the old scalar
epilogue verbatim again, tanhf included.

Numerics: bit-identical to the old epilogue over the full flag matrix -
slope {0, 0.1, -1} x bias {0,1} x residual {0,1} x 6 shapes = 72 combinations,
including t-tile tails (T=37), OC not a multiple of 16 (OC=24), IC=8/16/32 tails and
dilations 1/3/5. Verified with tests/bench_conv_epi.c --verify, which runs this same
micro-kernel standalone and asserts patched == old bit for bit; the slope<0 row of that
matrix is the row that was missing. Measured single-thread on EPYC 7K62, quiet box (load 0.04), GMAC/s
before -> after: stage4/IC16/K3 20.5 -> 36.5 (1.78x), stage3/IC32/K3 26.8 -> 38.3
(1.42x), stage2/IC64/K7 41.3 -> 45.6, stage1/IC128/K11 37.2 -> 38.2, stage0/IC256/K11
39.9 -> 41.1. A "no epilogue at all" upper bound measures the same as the new code,
i.e. the epilogue is no longer a bottleneck. Weighted over the dec resblocks that is
1.087x (dec ~1585 -> ~1463 ms, 62% -> ~67% of peak).

---
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 8067c16..ad0af7f 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -11583,6 +11583,70 @@ void ggml_compute_forward_add_leaky_relu(
 // clamp, partial t tail, partial oc tail) run a scalar path.
 // The epilogue applies bias + leaky with the exact stock expression
 // ((v > 0) ? v : 0) + slope * ((v < 0) ? v : 0) for bit-identical output.
+#if defined(__AVX2__)
+// --- conv_direct_1d epilogue helpers -------------------------------------------
+// The 6x16 accumulator block is (lane = oc, register = one t). The output/residual
+// layout is [oc][t], so each oc needs its 6 t values contiguous. The original
+// epilogue stored the 12 vectors into tmp[6][8] and read 96 scalars back (a 32B
+// store feeding 4B loads stalls store-to-load forwarding, and 96 scalar stores
+// occupy the 1/cycle store port). Transposing in registers and storing 6 floats
+// per oc fixes it: 22 shuffles + 32 stores per tile, no scalar round-trip.
+static inline __m256 conv_cd1d_leaky(__m256 v, float slope) {
+    const __m256 neg = _mm256_cmp_ps(v, _mm256_setzero_ps(), _CMP_LT_OQ);
+    return _mm256_blendv_ps(v, _mm256_mul_ps(v, _mm256_set1_ps(slope)), neg);
+}
+static inline __m128 conv_cd1d_leaky128(__m128 v, float slope) {
+    const __m128 neg = _mm_cmp_ps(v, _mm_setzero_ps(), _CMP_LT_OQ);
+    return _mm_blendv_ps(v, _mm_mul_ps(v, _mm_set1_ps(slope)), neg);
+}
+// r[j] = lanes 0..5 hold t0..t5 of oc j (lanes 6/7 are zero and must not be stored)
+static inline void conv_cd1d_transpose6x8(__m256 s0, __m256 s1, __m256 s2, __m256 s3,
+                                          __m256 s4, __m256 s5, __m256 r[8]) {
+    const __m256 z = _mm256_setzero_ps();
+    const __m256 u0 = _mm256_unpacklo_ps(s0, s1), u1 = _mm256_unpackhi_ps(s0, s1);
+    const __m256 u2 = _mm256_unpacklo_ps(s2, s3), u3 = _mm256_unpackhi_ps(s2, s3);
+    const __m256 u4 = _mm256_unpacklo_ps(s4, s5), u5 = _mm256_unpackhi_ps(s4, s5);
+    const __m256d v0 = _mm256_unpacklo_pd(_mm256_castps_pd(u0), _mm256_castps_pd(u2));
+    const __m256d v1 = _mm256_unpackhi_pd(_mm256_castps_pd(u0), _mm256_castps_pd(u2));
+    const __m256d v2 = _mm256_unpacklo_pd(_mm256_castps_pd(u1), _mm256_castps_pd(u3));
+    const __m256d v3 = _mm256_unpackhi_pd(_mm256_castps_pd(u1), _mm256_castps_pd(u3));
+    const __m256d v4 = _mm256_unpacklo_pd(_mm256_castps_pd(u4), _mm256_castps_pd(z));
+    const __m256d v5 = _mm256_unpackhi_pd(_mm256_castps_pd(u4), _mm256_castps_pd(z));
+    const __m256d v6 = _mm256_unpacklo_pd(_mm256_castps_pd(u5), _mm256_castps_pd(z));
+    const __m256d v7 = _mm256_unpackhi_pd(_mm256_castps_pd(u5), _mm256_castps_pd(z));
+    const __m256 c0 = _mm256_castpd_ps(v0), c1 = _mm256_castpd_ps(v1);
+    const __m256 c2 = _mm256_castpd_ps(v2), c3 = _mm256_castpd_ps(v3);
+    const __m256 c4 = _mm256_castpd_ps(v4), c5 = _mm256_castpd_ps(v5);
+    const __m256 c6 = _mm256_castpd_ps(v6), c7 = _mm256_castpd_ps(v7);
+    r[0] = _mm256_permute2f128_ps(c0, c4, 0x20);
+    r[4] = _mm256_permute2f128_ps(c0, c4, 0x31);
+    r[1] = _mm256_permute2f128_ps(c1, c5, 0x20);
+    r[5] = _mm256_permute2f128_ps(c1, c5, 0x31);
+    r[2] = _mm256_permute2f128_ps(c2, c6, 0x20);
+    r[6] = _mm256_permute2f128_ps(c2, c6, 0x31);
+    r[3] = _mm256_permute2f128_ps(c3, c7, 0x20);
+    r[7] = _mm256_permute2f128_ps(c3, c7, 0x31);
+}
+// add residual (if any), activation (if it had to wait for the residual), then
+// write exactly 6 floats: 16B + 8B. Never a full 32B store - lanes 6/7 belong to
+// the next t block (possibly another thread's).
+static inline void conv_cd1d_store6(float * o, __m256 v, const float * r,
+                                    bool has_res, bool has_act, float slope) {
+    __m128 lo = _mm256_castps256_ps128(v);
+    __m128 hi = _mm256_extractf128_ps(v, 1);
+    if (has_res) {
+        lo = _mm_add_ps(lo, _mm_loadu_ps(r));
+        hi = _mm_add_ps(hi, _mm_castsi128_ps(_mm_loadl_epi64((const __m128i *) (r + 4))));
+    }
+    if (has_act) {
+        lo = conv_cd1d_leaky128(lo, slope);
+        hi = conv_cd1d_leaky128(hi, slope);
+    }
+    _mm_storeu_ps(o, lo);
+    _mm_storel_epi64((__m128i *) (o + 4), _mm_castps_si128(hi));
+}
+#endif
+
 void ggml_compute_forward_conv_direct_1d(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
@@ -11763,9 +11827,12 @@ void ggml_compute_forward_conv_direct_1d(
                             a51 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 5), w1, a51);
                         }
                     }
-                    // epilogue: bias + optional leaky; stores are t-contiguous
-                    // per oc (extraction cost is negligible vs KP FMAs/tile)
-                    {
+                    // epilogue: bias (+ residual) (+ activation), same math and the same
+                    // fp32 accumulation order as before - only the register/stores shape
+                    // changes. tanh activations (slope < 0) keep the scalar path.
+                    const int64_t nvalid = OC - oc0 < 16 ? OC - oc0 : 16;
+                    if (has_act && slope < 0.f) {
+                        // scalar fallback: tanhf has no cheap AVX2 form
                         float tmp[TB][8];
                         for (int64_t j = 0; j < 16; ++j) {
                             const int64_t oc = oc0 + j;
@@ -11782,10 +11849,46 @@ void ggml_compute_forward_conv_direct_1d(
                             for (int64_t i = 0; i < TB; ++i) {
                                 float v = bv + tmp[i][ch];
                                 if (has_res) v = v + r_data[oc * OL + t0 + i];
-                                if (has_act) v = slope < 0.f ? tanhf(v) : (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                                // slope < 0 = tanh (dec.conv_post passes -1.0f): verbatim old line
+                                v = slope < 0.f ? tanhf(v)
+                                                : (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
                                 o_data[oc * OL + t0 + i] = v;
                             }
                         }
+                    } else {
+                        __m256 s0[2] = { a00, a01 }, s1[2] = { a10, a11 }, s2[2] = { a20, a21 };
+                        __m256 s3[2] = { a30, a31 }, s4[2] = { a40, a41 }, s5[2] = { a50, a51 };
+                        const __m256 bv0 = has_bias ? _mm256_loadu_ps(bp + oc0)     : _mm256_setzero_ps();
+                        const __m256 bv1 = has_bias ? _mm256_loadu_ps(bp + oc0 + 8) : _mm256_setzero_ps();
+                        // with a residual the leaky must come after the add, so defer it
+                        const bool act_early = has_act && !has_res;
+                        for (int h = 0; h < 2; ++h) {
+                            const __m256 bv = h ? bv1 : bv0;
+                            s0[h] = _mm256_add_ps(s0[h], bv);
+                            s1[h] = _mm256_add_ps(s1[h], bv);
+                            s2[h] = _mm256_add_ps(s2[h], bv);
+                            s3[h] = _mm256_add_ps(s3[h], bv);
+                            s4[h] = _mm256_add_ps(s4[h], bv);
+                            s5[h] = _mm256_add_ps(s5[h], bv);
+                            if (act_early) {
+                                s0[h] = conv_cd1d_leaky(s0[h], slope);
+                                s1[h] = conv_cd1d_leaky(s1[h], slope);
+                                s2[h] = conv_cd1d_leaky(s2[h], slope);
+                                s3[h] = conv_cd1d_leaky(s3[h], slope);
+                                s4[h] = conv_cd1d_leaky(s4[h], slope);
+                                s5[h] = conv_cd1d_leaky(s5[h], slope);
+                            }
+                        }
+                        __m256 tr0[8], tr1[8];
+                        conv_cd1d_transpose6x8(s0[0], s1[0], s2[0], s3[0], s4[0], s5[0], tr0);
+                        conv_cd1d_transpose6x8(s0[1], s1[1], s2[1], s3[1], s4[1], s5[1], tr1);
+                        for (int64_t j = 0; j < nvalid; ++j) {
+                            const int64_t oc = oc0 + j;
+                            conv_cd1d_store6(o_data + oc * OL + t0,
+                                             j < 8 ? tr0[j] : tr1[j - 8],
+                                             has_res ? r_data + oc * OL + t0 : nullptr,
+                                             has_res, has_act && !act_early, slope);
+                        }
                     }
                 }
             }
