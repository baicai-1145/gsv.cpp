+
+// ggml_compute_forward_supertonic_depthwise_1d
+
+void ggml_compute_forward_supertonic_depthwise_1d(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * x    = dst->src[0]; // [L, C, 1, 1]
+    const ggml_tensor * w    = dst->src[1]; // [K, 1, C, 1]
+    const ggml_tensor * bias = dst->src[2]; // [C] or NULL
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(w->type == GGML_TYPE_F32);
+    GGML_ASSERT(bias == NULL || bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    const int32_t * opts = (const int32_t *) dst->op_params;
+    const int K        = opts[0];
+    const int dilation = opts[1];
+    const int32_t layout = opts[2];
+    const int32_t causal = opts[3];
+    const int k_off = (causal != 0) ? -(K - 1) : -(K / 2);
+
+    int L, C, sxt, sxc, syt, syc;
+    if (layout == 0) {
+        L = (int) x->ne[0];
+        C = (int) x->ne[1];
+        sxt = 1;  sxc = L;
+        syt = 1;  syc = L;
+    } else {
+        C = (int) x->ne[0];
+        L = (int) x->ne[1];
+        sxt = C;  sxc = 1;
+        syt = C;  syc = 1;
+    }
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * x_data = (const float *) x->data;
+    const float * w_data = (const float *) w->data;
+    const float * b_data = bias ? (const float *) bias->data : NULL;
+          float * y_data = (float *) dst->data;
+
+    for (int c = ith; c < C; c += nth) {
+        const float bias_v = b_data ? b_data[c] : 0.0f;
+        const float * w_c = w_data + (size_t) c * K;
+        for (int t = 0; t < L; ++t) {
+            float sum = bias_v;
+            for (int k = 0; k < K; ++k) {
+                int s = t + (k + k_off) * dilation;
+                if (s < 0) s = 0;
+                else if (s >= L) s = L - 1;
+                sum += x_data[(size_t) s * sxt + (size_t) c * sxc] * w_c[k];
+            }
+            y_data[(size_t) t * syt + (size_t) c * syc] = sum;
+        }
+    }
+}
+
+// ggml_compute_forward_supertonic_layer_norm_channel
+
+void ggml_compute_forward_supertonic_layer_norm_channel(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * x = dst->src[0]; // [L, C, 1, 1]
+    const ggml_tensor * g = dst->src[1]; // [C]
+    const ggml_tensor * b = dst->src[2]; // [C]
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(g->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(eps));
+    const int32_t layout = ((const int32_t *) dst->op_params)[1];
+
+    int L, C, sxt, sxc, syt, syc;
+    if (layout == 0) {
+        // [T, C]: T inner.
+        L = (int) x->ne[0];
+        C = (int) x->ne[1];
+        sxt = 1;  sxc = L;
+        syt = 1;  syc = L;
+    } else {
+        // [C, T]: C inner.
+        C = (int) x->ne[0];
+        L = (int) x->ne[1];
+        sxt = C;  sxc = 1;
+        syt = C;  syc = 1;
+    }
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * x_data = (const float *) x->data;
+    const float * g_data = (const float *) g->data;
+    const float * b_data = (const float *) b->data;
+          float * y_data = (float *) dst->data;
+
+    // Layout-agnostic indexing via element strides.
+    for (int t = ith; t < L; t += nth) {
+        double mean = 0.0;
+        for (int c = 0; c < C; ++c) mean += x_data[(size_t) t * sxt + (size_t) c * sxc];
+        mean /= (double) C;
+        double var = 0.0;
+        for (int c = 0; c < C; ++c) {
+            const double d = (double) x_data[(size_t) t * sxt + (size_t) c * sxc] - mean;
+            var += d * d;
+        }
+        const float inv = 1.0f / sqrtf((float) (var / (double) C) + eps);
+        for (int c = 0; c < C; ++c) {
+            const float xv = x_data[(size_t) t * sxt + (size_t) c * sxc];
+            y_data[(size_t) t * syt + (size_t) c * syc] = (xv - (float) mean) * inv * g_data[c] + b_data[c];
+        }
+    }
+}
+
+// ggml_compute_forward_supertonic_pw2_residual
+
+void ggml_compute_forward_supertonic_pw2_residual(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * x        = dst->src[0]; // [L, C, 1, 1]
+    const ggml_tensor * bias     = dst->src[1]; // [C]
+    const ggml_tensor * gamma    = dst->src[2]; // [C]
+    const ggml_tensor * residual = dst->src[3]; // [L, C, 1, 1]
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(gamma->type == GGML_TYPE_F32);
+    GGML_ASSERT(residual->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    const int32_t layout = ((const int32_t *) dst->op_params)[0];
+
+    int L, C, sxt, sxc, syt, syc, srt, src;
+    if (layout == 0) {
+        L = (int) x->ne[0];
+        C = (int) x->ne[1];
+        sxt = 1;  sxc = L;
+        syt = 1;  syc = L;
+        srt = 1;  src = L;
+    } else {
+        C = (int) x->ne[0];
+        L = (int) x->ne[1];
+        sxt = C;  sxc = 1;
+        syt = C;  syc = 1;
+        srt = C;  src = 1;
+    }
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * x_data   = (const float *) x->data;
+    const float * b_data   = (const float *) bias->data;
+    const float * g_data   = (const float *) gamma->data;
+    const float * r_data   = (const float *) residual->data;
+          float * y_data   = (float *) dst->data;
+
+    // Stripe over channels.  For each channel c, bias and gamma are read
+    // once and applied across all L timesteps; layout flag flips x/y/r index
+    // strides between [T, C] and [C, T].
+    for (int c = ith; c < C; c += nth) {
+        const float bv = b_data[c];
+        const float gv = g_data[c];
+        for (int t = 0; t < L; ++t) {
+            const float xv = x_data[(size_t) t * sxt + (size_t) c * sxc];
+            const float rv = r_data[(size_t) t * srt + (size_t) c * src];
+            y_data[(size_t) t * syt + (size_t) c * syc] = rv + (xv + bv) * gv;
+        }
+    }
+}
+
+// ggml_compute_forward_supertonic_bias_gelu
+
+void ggml_compute_forward_supertonic_bias_gelu(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * x    = dst->src[0]; // [L, C, 1, 1]
+    const ggml_tensor * bias = dst->src[1]; // [C]
+
+    GGML_ASSERT(x->type    == GGML_TYPE_F32);
+    GGML_ASSERT(bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+
+    const int32_t layout = ((const int32_t *) dst->op_params)[0];
+
+    int L, C, sxt, sxc, syt, syc;
+    if (layout == 0) {
+        L = (int) x->ne[0];
+        C = (int) x->ne[1];
+        sxt = 1;  sxc = L;
+        syt = 1;  syc = L;
+    } else {
+        C = (int) x->ne[0];
+        L = (int) x->ne[1];
+        sxt = C;  sxc = 1;
+        syt = C;  syc = 1;
+    }
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * x_data = (const float *) x->data;
+    const float * b_data = (const float *) bias->data;
+          float * y_data = (float *)       dst->data;
+
+    static const float inv_sqrt_2 = 0.7071067811865475f;
+
+    for (int c = ith; c < C; c += nth) {
+        const float bv = b_data[c];
+        for (int t = 0; t < L; ++t) {
+            const float v = x_data[(size_t) t * sxt + (size_t) c * sxc] + bv;
+            y_data[(size_t) t * syt + (size_t) c * syc] = 0.5f * v * (1.0f + erff(v * inv_sqrt_2));
+        }
+    }
+}
+
+// ggml_compute_forward_supertonic_edge_pad_1d
+
+void ggml_compute_forward_supertonic_edge_pad_1d(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * x = dst->src[0]; // [L_in, C, 1, 1] or [C, L_in, 1, 1]
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    const int pad_left = ggml_get_op_params_i32(dst, 0);
+    const int32_t layout = ggml_get_op_params_i32(dst, 2);
+
+    int L_in, L_out, C, sxt, sxc, syt, syc;
+    if (layout == 0) {
+        L_in  = (int) x->ne[0];
+        C     = (int) x->ne[1];
+        L_out = (int) dst->ne[0];
+        sxt = 1;     sxc = L_in;   syt = 1;     syc = L_out;
+    } else {
+        C     = (int) x->ne[0];
+        L_in  = (int) x->ne[1];
+        L_out = (int) dst->ne[1];
+        sxt = C;     sxc = 1;      syt = C;     syc = 1;
+    }
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * x_data = (const float *) x->data;
+          float * y_data = (float *)       dst->data;
+
+    // Stripe over channels.  For each output time t, read from
+    // clamp(t - pad_left, 0, L_in - 1); layout flag picks strides.
+    for (int c = ith; c < C; c += nth) {
+        for (int t = 0; t < L_out; ++t) {
+            int src_t = t - pad_left;
+            if (src_t < 0)       src_t = 0;
+            if (src_t >= L_in)   src_t = L_in - 1;
+            y_data[(size_t) t * syt + (size_t) c * syc] =
+                x_data[(size_t) src_t * sxt + (size_t) c * sxc];
+        }
+    }
+}
+
+// ggml_compute_forward_snake
+//
+// Snake activation y = x + sin^2(a*x) * inv_b, with per-channel a and inv_b.
+// x / dst are [T, C] (T = ne0, contiguous); a and inv_b hold one F32 value per
+// channel.  Parallelized over channels (threads own disjoint [c*T, (c+1)*T)
+// bands).  ACE-Step Oobleck VAE.  CPU bring-up: F32 only.
+void ggml_compute_forward_snake(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+
+    const ggml_tensor * x     = dst->src[0];
+    const ggml_tensor * a     = dst->src[1];
+    const ggml_tensor * inv_b = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && inv_b->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+
+    const int64_t T = x->ne[0];
+    const int64_t C = x->ne[1];
+
+    const float * xd = (const float *) x->data;
+    const float * ad = (const float *) a->data;
+    const float * bd = (const float *) inv_b->data;
+          float * yd = (float *)       dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    // Split over channels: each thread owns disjoint time bands.
+    for (int64_t c = ith; c < C; c += nth) {
+        const float ac = ad[c];
+        const float bc = bd[c];
+        const float * xc = xd + c * T;
+              float * yc = yd + c * T;
+        for (int64_t t = 0; t < T; t++) {
+            const float xi = xc[t];
+            const float si = sinf(ac * xi);
+            yc[t] = xi + si * si * bc;
+        }
+    }
+}
+
+// Fused batched GRU reference (CPU).  Parallel over batch b; serial over the L time-steps.
+//   whh [H,3H], gi_all [3H,B,L] (precomputed Wih*x+bih), bhh [3H] -> dst [H,B,L].
+void ggml_compute_forward_gru(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * whh    = dst->src[0];  // [H, 3H]
+    const ggml_tensor * gi_all = dst->src[1];  // [3H, B, L]
+    const ggml_tensor * bhh    = dst->src[2];  // [3H]
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && whh->type == GGML_TYPE_F32 &&
+                gi_all->type == GGML_TYPE_F32 && bhh->type == GGML_TYPE_F32);
+
+    const int64_t H  = whh->ne[0];
+    const int64_t H3 = gi_all->ne[0];   // 3H
+    const int64_t B  = gi_all->ne[1];
+    const int64_t L  = gi_all->ne[2];
+    const bool reverse = ggml_get_op_params_i32(dst, 0) != 0;
+
+    const float * whh_d = (const float *) whh->data;    // whh[k + H*g]  (column g = whh_d + H*g)
+    const float * gi_d  = (const float *) gi_all->data; // gi[g + H3*b + H3*B*t]
+    const float * bhh_d = (const float *) bhh->data;    // bhh[g]
+    float *       dst_d = (float *)       dst->data;    // dst[j + H*b + H*B*t]
+
+    std::vector<float> h((size_t) H), gh((size_t) H3);
+
+    const int64_t per = (B + params->nth - 1) / params->nth;
+    const int64_t b0  = (int64_t) params->ith * per;
+    const int64_t b1  = std::min(b0 + per, B);
+
+    for (int64_t b = b0; b < b1; ++b) {
+        for (int64_t j = 0; j < H; ++j) h[j] = 0.0f;   // zero initial state
+        for (int64_t s = 0; s < L; ++s) {
+            const int64_t t  = reverse ? (L - 1 - s) : s;
+            const float * gi = gi_d + (H3 * b + H3 * B * t);
+            for (int64_t g = 0; g < H3; ++g) {          // gh = whh*h + bhh
+                const float * wcol = whh_d + H * g;
+                float acc = 0.0f;
+                for (int64_t k = 0; k < H; ++k) acc += wcol[k] * h[k];
+                gh[g] = acc + bhh_d[g];
+            }
+            float * out = dst_d + (H * b + H * B * t);
+            for (int64_t j = 0; j < H; ++j) {
+                const float r  = 1.0f / (1.0f + expf(-(gi[j]          + gh[j])));
+                const float z  = 1.0f / (1.0f + expf(-(gi[H + j]      + gh[H + j])));
+                const float nc = tanhf(gi[2 * H + j] + r * gh[2 * H + j]);
+                const float hn = nc + z * (h[j] - nc);   // h_new = nc + z*(h - nc)
+                h[j]   = hn;
+                out[j] = hn;
+            }
+        }
+    }
+}
+
+// learned-ops patch: fused add + leaky ReLU (HiFiGAN vocoder).
+//   dst = lrelu(a + b, slope)  in one pass, bit-identical to
+//   ggml_add followed by ggml_leaky_relu (same expression as
+//   ggml_vec_leaky_relu_f32, applied to the fused sum).
+//   a: [T, C] contiguous F32; b: [1, C] row-broadcast bias or [T, C]
+//   elementwise operand, contiguous F32.
+// Fused LayerNorm(x)*w + b over ne0 (row-wise reduction, same numerics as ggml_norm:
+// double accumulation, var = E[x^2] - mean^2, inv = 1/sqrt(var + eps)).
+void ggml_compute_forward_layernorm_affine(
+        const struct ggml_compute_params * params,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * x    = dst->src[0];
+    const struct ggml_tensor * r    = dst->src[1];
+    const struct ggml_tensor * bias = dst->src[2];
+    const struct ggml_tensor * wb   = dst->src[3];
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 && r->type == GGML_TYPE_F32);
+    GGML_ASSERT(wb->type == GGML_TYPE_F32 && ggml_nelements(wb) == 2 * x->ne[0]);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(r) && ggml_is_contiguous(dst));
+
+    const int64_t ne00  = x->ne[0];
+    const int64_t nrows = ggml_nrows(x);
+    const float   eps   = ggml_get_op_params_f32(dst, 0);
+    const int32_t flags = ggml_get_op_params_i32(dst, 1);
+    const bool    has_r = (flags & 1) != 0;
+    const bool    has_bias = (flags & 2) != 0;
+
+    const float * xd  = (const float *) x->data;
+    const float * rd  = (const float *) r->data;
+    const float * bsd = (const float *) bias->data;
+    const float * wd  = (const float *) wb->data;   // wb[0..ne00) = w
+    const float * bd  = wd + ne00;                  // wb[ne00..2*ne00) = b
+    float       * yd  = (float       *) dst->data;
+
+    for (int64_t row = params->ith; row < nrows; row += params->nth) {
+        const float * xr = xd + row * ne00;
+        const float * rr = rd + row * ne00;
+        float       * yr = yd + row * ne00;
+
+        ggml_float sum  = 0.0;
+        ggml_float sum2 = 0.0;
+        for (int64_t i = 0; i < ne00; ++i) {
+            const float v = xr[i] + (has_r ? rr[i] : 0.0f) + (has_bias ? bsd[i] : 0.0f);
+            sum  += v;
+            sum2 += (ggml_float) v * (ggml_float) v;
+        }
+
+        const float mean = (float) (sum / ne00);
+        const float var  = (float) (sum2 / ne00) - mean * mean;
+        const float inv  = 1.0f / sqrtf(var + eps);
+
+        for (int64_t i = 0; i < ne00; ++i) {
+            const float v = xr[i] + (has_r ? rr[i] : 0.0f) + (has_bias ? bsd[i] : 0.0f);
+            yr[i] = (v - mean) * inv * wd[i] + bd[i];
+        }
+    }
+}
+
+// Fused activation of (a + b), b is a [ne0] vector broadcast over the rows.
+void ggml_compute_forward_add_act(
+        const struct ggml_compute_params * params,
+        struct ggml_tensor * dst) {
+
+    const struct ggml_tensor * a = dst->src[0];
+    const struct ggml_tensor * b = dst->src[1];
+
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && a->type == GGML_TYPE_F32 && b->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(a) && ggml_is_contiguous(b));
+
+    const int64_t ne0 = a->ne[0];
+    const int64_t n   = ggml_nelements(dst);
+    const int32_t act = ggml_get_op_params_i32(dst, 0);
+
+    const float * ad = (const float *) a->data;
+    const float * bd = (const float *) b->data;
+    float       * dd = (float       *) dst->data;
+
+    const int64_t dr = (n + params->nth - 1) / params->nth;
+    const int64_t i0 = dr * params->ith;
+    const int64_t i1 = MIN(i0 + dr, n);
+
+    for (int64_t i = i0; i < i1; ++i) {
+        const float v = ad[i] + bd[i % ne0];
+        float o = v;
+        if (act == 1) {
+            o = v > 0.0f ? v : 0.0f;
+        } else if (act == 2) {
+            o = 0.5f * v * (1.0f + erff(v * 0.70710678118654752440f));
+        } else if (act == 3) {
+            // mish(v) = v * tanh(softplus(v)); softplus is linear above 20 for float
+            const float sp = v > 20.0f ? v : log1pf(expf(v));
+            o = v * tanhf(sp);
+        }
+        dd[i] = o;
+    }
+}
+
+void ggml_compute_forward_add_leaky_relu(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * a = dst->src[0];   // [T, C]
+    const ggml_tensor * b = dst->src[1];   // [1, C] or [T, C]
+
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_is_contiguous(b));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(dst->ne[0] == a->ne[0] && dst->ne[1] == a->ne[1]);
+    GGML_ASSERT(a->ne[1] == b->ne[1]);
+    GGML_ASSERT(b->ne[0] == 1 || b->ne[0] == a->ne[0]);
+
+    const int64_t T = a->ne[0];
+    const int64_t C = a->ne[1];
+
+    float slope;
+    memcpy(&slope, dst->op_params, sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const float * a_data = (const float *) a->data;
+    const float * b_data = (const float *) b->data;
+          float * y_data = (float *)       dst->data;
+
+    const bool elementwise = b->ne[0] != 1;
+
+    if (C >= nth) {
+        // Fast path: stripe over channels.  The bias value stays in a
+        // register and the inner loop walks contiguous t for both inputs and
+        // the output (auto-vectorizable: two selects + mul + add).
+        for (int64_t c = ith; c < C; c += nth) {
+            const float * ap = a_data + c * T;
+            const float * bp = b_data + (elementwise ? c * T : c);
+                  float * yp = y_data + c * T;
+            if (elementwise) {
+                for (int64_t t = 0; t < T; ++t) {
+                    const float v = ap[t] + bp[t];
+                    yp[t] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            } else {
+                const float bv = bp[0];
+                for (int64_t t = 0; t < T; ++t) {
+                    const float v = ap[t] + bv;
+                    yp[t] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            }
+        }
+    } else {
+        // Few channels (e.g. C < n_threads): split the flattened element
+        // range instead, aligned to row boundaries so the broadcast bias
+        // index only changes between rows.
+        const int64_t total = C * T;
+        const int64_t per   = (total + nth - 1) / nth;
+        const int64_t start = (int64_t) ith * per;
+        const int64_t stop  = MIN(start + per, total);
+        int64_t c = start / T;
+        int64_t t = start - c * T;
+        for (int64_t i = start; i < stop; /* advanced below */) {
+            const int64_t chunk = MIN(stop - i, T - t);
+            const float * ap = a_data + c * T + t;
+            const float * bp = b_data + (elementwise ? c * T + t : c);
+                  float * yp = y_data + c * T + t;
+            if (elementwise) {
+                for (int64_t k = 0; k < chunk; ++k) {
+                    const float v = ap[k] + bp[k];
+                    yp[k] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            } else {
+                const float bv = bp[0];
+                for (int64_t k = 0; k < chunk; ++k) {
+                    const float v = ap[k] + bv;
+                    yp[k] = (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                }
+            }
+            i += chunk;
+            t += chunk;
+            if (t == T) { t = 0; ++c; }
+        }
+    }
+}
+
+// f32 -> bf16 (round to nearest even), returned in the low 16 bits
+static inline uint32_t ggml_f32_to_bf16_bits(float v) {
+    uint32_t u;
+    memcpy(&u, &v, 4);
+    if ((u & 0x7f800000u) != 0x7f800000u) {
+        u += 0x7fffu + ((u >> 16) & 1u);
+        u &= 0xffff0000u;
+    }
+    return u >> 16;
+}
+
+// learned-ops patch: fused direct stride-1 1D convolution (HiFiGAN).
+//   out[t, oc] = sum_{ic, kw} w[kw, ic, oc] * x[t + kw*dil - pad, ic]
+//                (+ bias[oc]), then leaky ReLU(slope) when slope != 0.
+// No im2col buffer: the kernel is packed once per call into
+//   Wt[k = ic*K + kw][oc]  (row-major [IC*K, OCp], OCp = OC rounded up to 16)
+// by all threads in parallel (disjoint oc columns) followed by a threadpool
+// barrier, then each thread owns a balanced range of output t-blocks:
+//   for each oc-block (16 cols of Wt stay in L1/L2):
+//     for each 6-wide t-block in the thread's range: 6x16 AVX2 micro-kernel.
+// X rows of the thread's t-range stay L2-resident across the oc-block loop,
+// so X streams from RAM exactly once per call.  Edge tiles (conv boundary
+// clamp, partial t tail, partial oc tail) run a scalar path.
+// The epilogue applies bias + leaky with the exact stock expression
+// ((v > 0) ? v : 0) + slope * ((v < 0) ? v : 0) for bit-identical output.
+void ggml_compute_forward_conv_direct_1d(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * w    = dst->src[0];   // [K, IC, OC]
+    const ggml_tensor * x    = dst->src[1];   // [T, IC] contiguous
+    const ggml_tensor * bias = dst->src[2];   // [OC] or NULL
+
+    GGML_ASSERT(w->type == GGML_TYPE_F32 || w->type == GGML_TYPE_BF16);
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(bias == NULL || bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+
+    const int64_t K  = w->ne[0];
+    const int64_t IC = w->ne[1];
+    const int64_t OC = w->ne[2];
+    const int64_t T  = x->ne[0];
+    const int64_t OL = dst->ne[0];
+
+    const int pad = ggml_get_op_params_i32(dst, 0);
+    const int dil = ggml_get_op_params_i32(dst, 1);
+    float slope;
+    memcpy(&slope, (const char *) dst->op_params + 2 * sizeof(int32_t), sizeof(float));
+    const bool has_bias = ggml_get_op_params_i32(dst, 3) != 0;
+    float in_scale;
+    memcpy(&in_scale, (const char *) dst->op_params + 4 * sizeof(int32_t), sizeof(float));
+    float in_slope;
+    memcpy(&in_slope, (const char *) dst->op_params + 5 * sizeof(int32_t), sizeof(float));
+    const bool has_res = ggml_get_op_params_i32(dst, 6) != 0;
+    const bool has_act  = slope != 0.0f;
+    const bool has_in   = in_scale != 1.0f || in_slope != 0.0f;
+    const ggml_tensor * res = dst->src[3];   // [OL, OC] contiguous or NULL
+
+    // ================= bf16 weights, fp32 accumulation (vdpbf16ps) =================
+    // Both operands bf16, every product pair accumulated in fp32; dec stack measured
+    // cos 0.999917 -> 0.999763 against the f32 path.
+    if (w->type == GGML_TYPE_BF16) {
+        // bf16 权重: 走单独用 target("avx512f,avx512bf16") 编译的内核 (见 ops_conv_bf16.cpp),
+        // 运行期再确认一次 CPU 能力 —— 这样 AVX2 构建也能用上它, 而不用把整个库编成 AVX-512。
+        if (gsv_conv_bf16_available()) {
+            gsv_conv_bf16_args a;
+            a.wdata = params->wdata; a.ith = params->ith; a.nth = params->nth; a.tp = params->threadpool;
+            a.w = w; a.x = x; a.bias = bias; a.res = res; a.dst = dst;
+            a.K = K; a.IC = IC; a.OC = OC; a.T = T; a.OL = OL; a.pad = pad; a.dil = dil;
+            a.slope = slope; a.in_scale = in_scale; a.in_slope = in_slope;
+            a.has_res = has_res; a.has_act = has_act; a.has_in = has_in;
+            if (gsv_conv_direct_1d_bf16(a)) return;
+        }
+        GGML_ABORT("conv_direct_1d: bf16 weights present but no usable bf16 kernel");
+    }
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t OCp = ((OC + 15) / 16) * 16;
+    const int64_t KP  = IC * K;
+    const int64_t L   = T + 2*pad;              // padded X row length
+
+    float * wdata = (float *) params->wdata;
+    float * Wt    = wdata;                      // [KP][OCp] packed kernel
+    float * bp    = wdata + KP * OCp;           // [OCp] bias, zero padded
+    float * Xp    = bp + OCp;                   // [IC][L] zero-padded X
+    GGML_ASSERT(params->wsize >= (size_t)(KP * OCp + OCp + IC * L) * sizeof(float));
+
+    const float * x_data = (const float *) x->data;
+    const float * w_data = (const float *) w->data;
+    const float * b_data = bias ? (const float *) bias->data : nullptr;
+    const float * r_data = has_res ? (const float *) res->data : nullptr;
+          float * o_data = (float *) dst->data;
+
+    // phase 1 (parallel, disjoint): pack W^T columns, bias, and the
+    // zero-padded X copy (removes all boundary clamping from phase 2)
+    {
+        const int64_t per = (OCp + nth - 1) / nth;
+        const int64_t c0  = std::min<int64_t>(ith * per, OCp);
+        const int64_t c1  = std::min<int64_t>(c0 + per, OCp);
+        for (int64_t oc = c0; oc < c1; ++oc) {
+            for (int64_t ic = 0; ic < IC; ++ic) {
+                for (int64_t kw = 0; kw < K; ++kw) {
+                    // w[kw, ic, oc] row-major: ((oc*IC) + ic)*K + kw
+                    const float v = (oc < OC)
+                        ? w_data[((oc * IC) + ic) * K + kw]
+                        : 0.0f;
+                    Wt[(ic * K + kw) * OCp + oc] = v;
+                }
+            }
+            bp[oc] = (oc < OC && b_data) ? b_data[oc] : 0.0f;
+        }
+    }
+    {
+        // X rows are large; split rows across threads instead.
+        // When has_in, the pad copy also folds the producer-side
+        // scale/leaky (bit-identical: leaky(x * s) elementwise, applied
+        // here once per element instead of in a separate pass).
+        const int64_t per_ic = (IC + nth - 1) / nth;
+        const int64_t ic0 = std::min<int64_t>(ith * per_ic, IC);
+        const int64_t ic1 = std::min<int64_t>(ic0 + per_ic, IC);
+        for (int64_t ic = ic0; ic < ic1; ++ic) {
+            float * row = Xp + ic * L;
+            memset(row, 0, pad * sizeof(float));
+            if (!has_in) {
+                memcpy(row + pad, x_data + ic * T, T * sizeof(float));
+            } else {
+                const float * src = x_data + ic * T;
+                float * dstv = row + pad;
+                for (int64_t t = 0; t < T; ++t) {
+                    float v = src[t];
+                    if (in_scale != 1.0f) v *= in_scale;
+                    if (in_slope != 0.0f) v = (v > 0.f ? v : 0.f) + in_slope * (v < 0.f ? v : 0.f);
+                    dstv[t] = v;
+                }
+            }
+            memset(row + pad + T, 0, (L - pad - T) * sizeof(float));
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // phase 2: each thread owns a balanced range of 6-wide t-blocks.  Within
+    // the range, superblocks (oc-super x t-super) keep the X slice and the
+    // packed-W slice L2-resident: the t-super's X window is re-read from L2
+    // across the oc loop, the oc-super's Wt columns from L2/L3 across the t
+    // loop, so both X and Wt stream from RAM roughly once per call.
+    const int64_t TB  = 6;                      // micro-kernel t height
+    const int64_t n_tb = (OL + TB - 1) / TB;    // 6-wide t blocks
+    const int64_t n_ob = OCp / 16;              // 16-wide oc blocks
+
+    // superblock sizes: X slice <= ~64KB, Wt slice <= ~128KB
+    const int64_t TSB = std::max<int64_t>(1, std::min<int64_t>(32,
+            (int64_t)(65536 / (TB * IC * 4 + 1))));
+    const int64_t OSB = std::max<int64_t>(1, std::min<int64_t>(n_ob,
+            (int64_t)(131072 / (16 * KP * 4 + 1))));
+
+    const int64_t per_t = (n_tb + nth - 1) / nth;
+    const int64_t tb0   = std::min<int64_t>(ith * per_t, n_tb);
+    const int64_t tb1   = std::min<int64_t>(tb0 + per_t, n_tb);
+
+#if defined(__AVX2__)
+    for (int64_t ts = tb0; ts < tb1; ts += TSB) {
+        const int64_t te = std::min<int64_t>(ts + TSB, tb1);
+        for (int64_t ob = 0; ob < n_ob; ob += OSB) {
+            const int64_t oe = std::min<int64_t>(ob + OSB, n_ob);
+            for (int64_t ob2 = ob; ob2 < oe; ++ob2) {
+                const int64_t oc0 = ob2 * 16;
+                const float * Wb  = Wt + oc0;   // Wt[k*OCp + oc0 .. +15]
+                for (int64_t tb = ts; tb < te; ++tb) {
+                    const int64_t t0 = tb * TB;
+                    if (t0 + TB > OL) {
+                        // partial tail block (at most one per call): scalar
+                        for (int64_t t = t0; t < OL; ++t) {
+                            for (int64_t oc = oc0; oc < std::min<int64_t>(oc0 + 16, OC); ++oc) {
+                                float acc = has_bias ? bp[oc] : 0.0f;
+                                for (int64_t ic = 0; ic < IC; ++ic) {
+                                    const float * xr = Xp + ic * L + t0;
+                                    for (int64_t kw = 0; kw < K; ++kw) {
+                                        acc += Wt[(ic * K + kw) * OCp + oc] * xr[t - t0 + kw * dil];
+                                    }
+                                }
+                                if (has_res) acc = acc + r_data[oc * OL + t];
+                                if (has_act) acc = slope < 0.f ? tanhf(acc) : (acc > 0.f ? acc : 0.f) + slope * (acc < 0.f ? acc : 0.f);
+                                o_data[oc * OL + t] = acc;
+                            }
+                        }
+                        continue;
+                    }
+                    __m256 a00 = _mm256_setzero_ps(), a01 = _mm256_setzero_ps();
+                    __m256 a10 = _mm256_setzero_ps(), a11 = _mm256_setzero_ps();
+                    __m256 a20 = _mm256_setzero_ps(), a21 = _mm256_setzero_ps();
+                    __m256 a30 = _mm256_setzero_ps(), a31 = _mm256_setzero_ps();
+                    __m256 a40 = _mm256_setzero_ps(), a41 = _mm256_setzero_ps();
+                    __m256 a50 = _mm256_setzero_ps(), a51 = _mm256_setzero_ps();
+                    for (int64_t ic = 0; ic < IC; ++ic) {
+                        // pointer-increment addressing: the per-kw address
+                        // chains are 1-cycle adds (imul-on-counter chains were
+                        // measured to gate broadcast dispatch and cost ~26%)
+                        const float * xp = Xp + ic * L + t0;
+                        const float * wp = Wb + ic * K * OCp;
+                        for (int kw = 0; kw < K; ++kw, xp += dil, wp += OCp) {
+                            // Wt lives in the shared work buffer, whose base is only
+                            // guaranteed to be 16-byte aligned: use unaligned loads.
+                            const __m256 w0 = _mm256_loadu_ps(wp);
+                            const __m256 w1 = _mm256_loadu_ps(wp + 8);
+                            a00 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 0), w0, a00);
+                            a01 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 0), w1, a01);
+                            a10 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 1), w0, a10);
+                            a11 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 1), w1, a11);
+                            a20 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 2), w0, a20);
+                            a21 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 2), w1, a21);
+                            a30 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 3), w0, a30);
+                            a31 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 3), w1, a31);
+                            a40 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 4), w0, a40);
+                            a41 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 4), w1, a41);
+                            a50 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 5), w0, a50);
+                            a51 = _mm256_fmadd_ps(_mm256_broadcast_ss(xp + 5), w1, a51);
+                        }
+                    }
+                    // epilogue: bias + optional leaky; stores are t-contiguous
+                    // per oc (extraction cost is negligible vs KP FMAs/tile)
+                    {
+                        float tmp[TB][8];
+                        for (int64_t j = 0; j < 16; ++j) {
+                            const int64_t oc = oc0 + j;
+                            if (oc >= OC) break;
+                            const int hi = j >= 8 ? 1 : 0;
+                            const int ch = (int)(j & 7);
+                            const float bv = has_bias ? bp[oc] : 0.0f;
+                            _mm256_storeu_ps(&tmp[0][0], hi ? a01 : a00);
+                            _mm256_storeu_ps(&tmp[1][0], hi ? a11 : a10);
+                            _mm256_storeu_ps(&tmp[2][0], hi ? a21 : a20);
+                            _mm256_storeu_ps(&tmp[3][0], hi ? a31 : a30);
+                            _mm256_storeu_ps(&tmp[4][0], hi ? a41 : a40);
+                            _mm256_storeu_ps(&tmp[5][0], hi ? a51 : a50);
+                            for (int64_t i = 0; i < TB; ++i) {
+                                float v = bv + tmp[i][ch];
+                                if (has_res) v = v + r_data[oc * OL + t0 + i];
+                                if (has_act) v = slope < 0.f ? tanhf(v) : (v > 0.f ? v : 0.f) + slope * (v < 0.f ? v : 0.f);
+                                o_data[oc * OL + t0 + i] = v;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+#else
+    // scalar fallback (no AVX2): same math, per-element
+    for (int64_t tb = tb0; tb < tb1; ++tb) {
+        const int64_t t0 = tb * TB;
+        for (int64_t t = t0; t < std::min<int64_t>(t0 + TB, OL); ++t) {
+            for (int64_t oc = 0; oc < OC; ++oc) {
+                float acc = has_bias ? bp[oc] : 0.0f;
+                for (int64_t ic = 0; ic < IC; ++ic) {
+                    const float * xr = Xp + ic * L + t0;
+                    for (int64_t kw = 0; kw < K; ++kw) {
+                        acc += Wt[(ic * K + kw) * OCp + oc] * xr[t - t0 + kw * dil];
+                    }
+                }
+                if (has_res) acc = acc + r_data[oc * OL + t];
+                if (has_act) acc = slope < 0.f ? tanhf(acc) : (acc > 0.f ? acc : 0.f) + slope * (acc < 0.f ? acc : 0.f);
+                o_data[oc * OL + t] = acc;
+            }
+        }
+    }
+#endif
+}
+
+void ggml_compute_forward_zero_upsample(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * src = dst->src[0];
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && src->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(dst));
+
+    const int64_t s  = ggml_get_op_params_i32(dst, 0);
+    const int64_t F  = src->ne[0];
+    const int64_t Fu = dst->ne[0];
+    const int64_t R  = src->ne[1] * src->ne[2] * src->ne[3];   // rows (ne1*ne2*ne3)
+
+    const float * src_data = (const float *) src->data;
+    float       * dst_data = (float *) dst->data;
+
+    // parallel over rows: zero each output row, then scatter the input at stride s.
+    const int64_t per_thread = (R + params->nth - 1) / params->nth;
+    const int64_t start = params->ith * per_thread;
+    const int64_t end   = MIN(start + per_thread, R);
+
+    for (int64_t r = start; r < end; ++r) {
+        const float * sp = src_data + r * F;
+        float       * dp = dst_data + r * Fu;
+        for (int64_t i = 0; i < Fu; ++i) dp[i] = 0.0f;
+        for (int64_t f = 0; f < F; ++f) dp[f * s] = sp[f];
+    }
+}
+
+void ggml_compute_forward_channel_shuffle(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src = dst->src[0];
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && src->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(dst));
+
+    const int64_t G  = ggml_get_op_params_i32(dst, 0);
+    const int64_t FT = src->ne[0] * src->ne[1];
+    const int64_t C  = src->ne[2];
+    const int64_t Bc = src->ne[3];
+    const int64_t cg = C / G;
+
+    const float * src_data = (const float *) src->data;
+    float       * dst_data = (float *) dst->data;
+
+    // parallel over output planes (c' + C*b): copy the FT plane from the shuffled input channel.
+    const int64_t nplanes = C * Bc;
+    const int64_t per_thread = (nplanes + params->nth - 1) / params->nth;
+    const int64_t start = params->ith * per_thread;
+    const int64_t end   = MIN(start + per_thread, nplanes);
+
+    for (int64_t p = start; p < end; ++p) {
+        const int64_t cprime = p % C;
+        const int64_t b      = p / C;
+        const int64_t in_c   = (cprime % G) * cg + cprime / G;
+        const float * sp = src_data + (in_c + C * b) * FT;
+        float       * dp = dst_data + p * FT;
+        for (int64_t i = 0; i < FT; ++i) dp[i] = sp[i];
+    }
+}
+
+void ggml_compute_forward_affine_prelu(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * x     = dst->src[0];
+    const ggml_tensor * aw    = dst->src[1];
+    const ggml_tensor * ab    = dst->src[2];
+    const ggml_tensor * slope = dst->src[3];
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(dst));
+
+    const int64_t F  = x->ne[0];
+    const int64_t T  = x->ne[1];
+    const int64_t C  = x->ne[2];
+    const int64_t Bc = x->ne[3];
+
+    const float * xd  = (const float *) x->data;
+    const float * awd = (const float *) aw->data;
+    const float * abd = (const float *) ab->data;
+    const float * sld = (const float *) slope->data;
+    float       * dd  = (float *) dst->data;
+
+    // parallel over planes (c + C*b); per element: affine + per-channel prelu in scalar op order.
+    const int64_t nplanes = C * Bc;
+    const int64_t per_thread = (nplanes + params->nth - 1) / params->nth;
+    const int64_t start = params->ith * per_thread;
+    const int64_t end   = MIN(start + per_thread, nplanes);
+
+    for (int64_t p = start; p < end; ++p) {
+        const int64_t c   = p % C;
+        const float * awc = awd + c * F;
+        const float * abc = abd + c * F;
+        const float   sl  = sld[c];
+        const float * xp  = xd + p * F * T;
+        float       * dp  = dd + p * F * T;
+        for (int64_t i = 0; i < F * T; ++i) {
+            const float xv = xp[i];
+            const float r  = xv > 0.0f ? xv : 0.0f;
+            const float n  = xv - r;
+            const float pr = r + sl * n;
+            const float a  = xv * awc[i % F] + abc[i % F];
+            dp[i] = a + pr;
+        }
+    }
+}
